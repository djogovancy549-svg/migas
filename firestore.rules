rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Settings Collection Rule
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'djogovancy549@gmail.com' ||
        request.auth.token.email == 'bagianekonomisdangk@gmail.com'
      );
    }
  }
}
